{
  "name": "supabox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:db && npm run build",
    "db:seed-sql": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-catalog-seed.mts",
    "test:db": "node supabase/tests/schema.test.mjs",
    "catalog:sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sync-catalog.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
