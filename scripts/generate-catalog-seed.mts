/**
 * Generates supabase/migrations/*_seed_mock_catalog.sql from src/data/games.ts,
 * so database rows and the bundled mock catalog share the same stable IDs.
 * Run: npm run db:seed-sql   (Node 24 runs TypeScript directly.)
 */
import { writeFileSync } from "node:fs";
import { games } from "../src/data/games.ts";

const q = (v: string | null | undefined) => (v == null ? "null" : `'${v.replace(/'/g, "''")}'`);
const arr = (xs: string[]) => `array[${xs.map(q).join(", ")}]::text[]`;

const rows = games.map(
  (g) =>
    `  (${q(g.id)}, ${q(g.slug)}, ${q(g.title)}, ${g.releaseDate ? `${q(g.releaseDate)}::date` : "null"}, ${q(g.summary)},\n` +
    `   ${q(g.description)}, ${q(g.developer)}, ${q(g.publisher)}, ${arr(g.platforms)}, ${arr(g.genres)}, ${q(g.externalRef.provider)}, ${q(g.externalRef.id)})`,
);

const sql = `-- Prototype catalog: the fictional games from src/data/games.ts.
-- GENERATED by scripts/generate-catalog-seed.mts — do not edit by hand.
-- Phase 3 replaces this with a licensed catalog provider sync.

insert into public.games (id, slug, title, release_date, summary, description, developer, publisher, platforms, genres, provider, provider_id)
values
${rows.join(",\n")}
on conflict (id) do update set
  slug = excluded.slug, title = excluded.title, release_date = excluded.release_date,
  summary = excluded.summary, description = excluded.description, developer = excluded.developer,
  publisher = excluded.publisher, platforms = excluded.platforms, genres = excluded.genres;
`;

writeFileSync(new URL("../supabase/migrations/20261110000100_seed_mock_catalog.sql", import.meta.url), sql);
console.log(`Wrote ${games.length} games.`);
